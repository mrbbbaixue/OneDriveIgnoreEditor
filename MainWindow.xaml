<Window
    x:Class="OneDriveIgnoreEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OneDriveIgnoreEditor"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="OneDriveIgnoreEditor"
    Width="650"
    Height="600"
    MinWidth="650"
    MinHeight="600"
    PreviewMouseDown="Window_PreviewMouseDown"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True">
    <Window.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="MainTitleTextBlock"
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                />
            <DataGrid
                x:Name="IgnoreDataGrid"
                Grid.Row="1"
                Margin="0,0,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="True"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                CellEditEnding="IgnoreDataGrid_CellEditEnding"
                HeadersVisibility="Column"
                ItemsSource="{Binding IgnoreRules}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Rule, UpdateSourceTrigger=PropertyChanged}"
                        Header="" />
                    <DataGridTemplateColumn Width="70" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="删除"
                                    Visibility="{Binding Rule, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="AddButton"
                    Width="80"
                    Margin="5"
                    Click="AddNewButton_Click"
                    Content="" />
                <Button
                    x:Name="SaveButton"
                    Width="80"
                    Margin="5"
                    Click="SaveButton_Click"
                    Content="" />
                <Button
                    x:Name="RefreshButton"
                    Width="80"
                    Margin="5"
                    Click="RefreshButton_Click"
                    Content="" />
                <Button
                    x:Name="ImportButton"
                    Margin="5"
                    Click="ImportButton_Click"
                    Content="" />
                <Button
                    x:Name="RestartOneDriveButton"
                    Margin="5"
                    Click="RestartOneDriveButton_Click"
                    Content="" />
            </StackPanel>
        </Grid>
        <StatusBar Grid.Row="1">
            <StatusBarItem Margin="5">
                <TextBlock x:Name="StatusTextBlock" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>